rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isCafeManager() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'cafe_manager';
    }

    function isOrganizer() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'organizer';
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin(); // Allow user to update their own profile or admin to update any
      allow delete: if isAdmin(); // Only admins can delete user profiles
    }

    // Rules for 'cafes' collection
    match /cafes/{cafeId} {
      allow read: if isSignedIn(); // All authenticated users can browse cafes
      allow create: if isCafeManager() && request.auth.uid == cafeId; // Manager can create their own profile
      allow update: if isCafeManager() && request.auth.uid == resource.data.managerId; // Cafe manager can only update their own cafe profile
      allow delete: if isCafeManager() && request.auth.uid == resource.data.managerId; // Cafe manager can only delete their own cafe profile
    }

    // Rules for 'organizers' collection
    match /organizers/{organizerId} {
      allow read: if isSignedIn(); // All authenticated users can browse organizers
      allow create: if isOrganizer() && request.auth.uid == organizerId; // Organizer can create their own profile
      allow update, delete: if isOwner(organizerId); // Organizers can manage their own profile
    }

    // Rules for 'requests' (Booking Requests)
    match /requests/{requestId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.organizerId || request.auth.uid == resource.data.managerId);
      allow create: if isOrganizer(); // Only organizers can create booking requests
      allow update: if isCafeManager() && request.auth.uid == resource.data.managerId; // Only the involved cafe manager can update status
      allow delete: if false; // Disallow deletion for record-keeping
    }

    // Rules for 'collaborationRequests'
    match /collaborationRequests/{collabId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.organizerId || request.auth.uid == resource.data.managerId);
      allow create: if isCafeManager(); // Only cafe managers can create collaboration requests
      allow update: if isOrganizer() && request.auth.uid == resource.data.organizerId; // Only the involved organizer can update status
      allow delete: if false;
    }
    
    // Rules for 'notifications' collection
    match /notifications/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Rules for 'chats' collection
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Rules for 'messages' subcollection within a chat
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false; // Messages are immutable
      }
    }
  }
}

    