rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access for the homepage background image
    match /back.webp {
      allow read: if true;
    }
    // Cafe images are publicly readable once uploaded.
    // Only the authenticated user matching {userId} can upload image files < 10MB.
    // Only the authenticated user matching {userId} can upload image files < 10MB (excluding SVG).
    match /cafe_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.size < 10 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*');
                      && request.resource.contentType.matches('image/.*')
                      && request.resource.contentType != 'image/svg+xml';
    }
    // Organizer images are publicly readable once uploaded.
    // Only the authenticated user matching {userId} can upload image files < 10MB.
    // Only the authenticated user matching {userId} can upload image files < 10MB (excluding SVG).
    match /organizer_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.size < 10 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*');
                      && request.resource.contentType.matches('image/.*')
                      && request.resource.contentType != 'image/svg+xml';
    }
    // Payment proofs: Max 5MB, image only
    // Payment proofs: Max 5MB, image only (excluding SVG)
    match /payment_proofs/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.size < 5 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*');
                      && request.resource.contentType.matches('image/.*')
                      && request.resource.contentType != 'image/svg+xml';
    }
  }
}
